# Required for web search tool (Gemini Flash + Google Search grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Telegram channel (if channel: telegram in agent.yaml)
PAT_TG_BOT_TOKEN=your_telegram_bot_token
PAT_TG_CHAT_ID=your_telegram_chat_id

# Optional — API call tool (Alpaca paper/live brokerage)
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_PAPER=true

# Optional — API call tool (The Odds API)
ODDS_API_KEY=your_odds_api_key

# Optional — Promptfoo semantic grading uses the same key
GOOGLE_API_KEY=same_as_gemini_api_key

# Optional — where to write conversation memory, status snapshots, logs.
# Defaults to ~/.patrick-agent
# AGENT_DATA_DIR=~/.patrick-agent

# Optional — which Ollama model to evaluate against. Defaults to gemma3:12b.
# AGENT_MODEL=gemma3:12b
